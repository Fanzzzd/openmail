{
  "name": "openmail",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo -F @openmail/desktop dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:perf": "pnpm --filter @openmail/core test:perf",
    "perf:cost": "pnpm --filter @openmail/core perf:cost",
    "check": "oxlint && oxfmt --check .",
    "audit:prod": "node scripts/audit-prod.mjs",
    "cli": "node packages/cli/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.17.0"
}
