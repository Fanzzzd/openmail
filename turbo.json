{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "@openmail/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "env": [
        "OPENMAIL_GOOGLE_CLIENT_ID",
        "OPENMAIL_GOOGLE_CLIENT_SECRET",
        "OPENMAIL_MICROSOFT_CLIENT_ID",
        "OPENMAIL_BUILD_COMMIT",
        "GITHUB_SHA"
      ],
      "inputs": ["$TURBO_DEFAULT$", "oauth-clients.local.json"]
    },
    "@openmail/docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"],
      "env": ["NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT",
        "OPENMAIL_PERF_FACTOR"
      ]
    },
    "@openmail/core#test": {
      "dependsOn": ["^build", "build", "@openmail/cli#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/apps/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
        "$TURBO_ROOT$/packages/cli/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/{dist,out,.next,release}/**",
        "!$TURBO_ROOT$/packages/cli/node_modules/**",
        "!$TURBO_ROOT$/packages/cli/dist/**",
        "$TURBO_ROOT$/spikes/media/artifacts/embeddings-hybrid.json"
      ],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT"
      ]
    },
    "@openmail/cli#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/demo-data.mjs"],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT"
      ]
    },
    "@openmail/desktop#test": {
      "dependsOn": ["^build", "build"],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT",
        "OPENMAIL_PERF_FACTOR"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@openmail/docs#test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
