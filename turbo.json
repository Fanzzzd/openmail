{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "@openmail/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "env": [
        "OPENMAIL_GOOGLE_CLIENT_ID",
        "OPENMAIL_GOOGLE_CLIENT_SECRET",
        "OPENMAIL_MICROSOFT_CLIENT_ID",
        "OPENMAIL_BUILD_COMMIT",
        "GITHUB_SHA"
      ],
      "inputs": ["$TURBO_DEFAULT$", "oauth-clients.local.json"]
    },
    "@openmail/docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"],
      "env": ["NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT",
        "OPENMAIL_PERF_FACTOR"
      ]
    },
    "@openmail/core#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/spikes/media/artifacts/embeddings-hybrid.json"],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT",
        "OPENMAIL_PERF_FACTOR",
        "OPENMAIL_PERF_MEASURE",
        "OPENMAIL_PERF_ANALYZE",
        "OPENMAIL_SPARSE_PERF_REPORT",
        "OPENMAIL_MIGRATION_REPORT",
        "OPENMAIL_SYNC_REPORT",
        "OPENMAIL_SEARCH_PROFILE",
        "OPENMAIL_PROFILE_DATABASE",
        "OPENMAIL_PROFILE_REPORT",
        "OPENMAIL_TEST_MODELS",
        "OPENMAIL_DIFF_SEED"
      ]
    },
    "@openmail/repo-checks#test": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/{apps,packages}/*/package.json",
        "$TURBO_ROOT$/scripts/*.{js,mjs,cjs}",
        "$TURBO_ROOT$/apps/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
        "$TURBO_ROOT$/packages/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
        "!$TURBO_ROOT$/{apps,packages}/**/node_modules/**",
        "!$TURBO_ROOT$/{apps,packages}/**/{dist,out,.next,release}/**"
      ],
      "env": ["CI", "VITEST_MAX_WORKERS", "OPENMAIL_TEST_TIME_SCALE"]
    },
    "@openmail/cli#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/demo-data.mjs"],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT",
        "OPENMAIL_PERF_FACTOR"
      ]
    },
    "@openmail/desktop#test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/docs/security.md",
        "$TURBO_ROOT$/docs/agents.md",
        "$TURBO_ROOT$/docs/licenses/**",
        "$TURBO_ROOT$/THIRD_PARTY_NOTICES.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/scripts/check-licenses.mjs",
        "$TURBO_ROOT$/scripts/demo-data.mjs",
        "$TURBO_ROOT$/apps/mobile/src/locales/*/messages.po"
      ],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT",
        "OPENMAIL_PERF_FACTOR",
        "OPENMAIL_WEB_SHOT",
        "OPENMAIL_PHONE_WEB_DEBUG"
      ]
    },
    "@openmail/mobile#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/scripts/i18n-missing.mjs",
        "$TURBO_ROOT$/patches/**"
      ],
      "env": [
        "CI",
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_TEST_TIME_SCALE",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT",
        "OPENMAIL_PERF_FACTOR"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@openmail/docs#test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["CI", "OPENMAIL_TEST_TIME_SCALE"]
    }
  }
}
