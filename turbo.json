{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "@openmail/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "env": [
        "OPENMAIL_GOOGLE_CLIENT_ID",
        "OPENMAIL_GOOGLE_CLIENT_SECRET",
        "OPENMAIL_MICROSOFT_CLIENT_ID"
      ],
      "inputs": ["$TURBO_DEFAULT$", "oauth-clients.local.json"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "OPENMAIL_LOW_MEMORY_TESTS",
        "VITEST_MAX_WORKERS",
        "OPENMAIL_PERF",
        "OPENMAIL_PERF_REPORT"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
