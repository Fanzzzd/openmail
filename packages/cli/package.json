{
  "name": "@openmail/cli",
  "version": "0.1.0",
  "private": true,
  "description": "openmail CLI and MCP server over the local mail database",
  "license": "MIT",
  "bin": {
    "openmail": "bin/openmail.js",
    "openmail-mcp": "bin/openmail-mcp.js"
  },
  "type": "module",
  "exports": {
    "./mcp-server": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@openmail/core": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
