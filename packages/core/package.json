{
  "name": "@openmail/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./oauth-client-sources": {
      "types": "./dist/providers/oauth-client-sources.d.ts",
      "default": "./dist/providers/oauth-client-sources.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "default": "./dist/portable.js"
    },
    "./node": {
      "types": "./dist/platform/node/index.d.ts",
      "default": "./dist/platform/node/index.js"
    },
    "./testing/node": {
      "types": "./dist/platform/node/testing.d.ts",
      "default": "./dist/platform/node/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-workers.mjs",
    "check-types": "tsc -p tsconfig.json",
    "test": "vitest run",
    "perf:cost": "node --max-old-space-size=192 scripts/performance-cost.mjs",
    "test:perf": "OPENMAIL_PERF=1 OPENMAIL_LOW_MEMORY_TESTS=1 NODE_OPTIONS=--max-old-space-size=192 vitest run src/platform/node/performance-large.test.ts src/platform/node/visible-text-cost.test.ts src/platform/node/sync-performance.test.ts src/platform/node/bytes.test.ts src/platform/node/seed-rate.test.ts"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/sql-sqlite-node": "4.0.3",
    "@exodus/bytes": "1.16.0",
    "@huggingface/transformers": "4.3.1",
    "@napi-rs/keyring": "^2.1.1",
    "@noble/hashes": "^2.4.0",
    "buffer": "^6.0.3",
    "color-string": "2.1.4",
    "css-select": "7.0.0",
    "css-tree": "^3.2.1",
    "effect": "4.0.3",
    "htmlparser2": "^12.0.0",
    "ical.js": "^2.2.1",
    "imapflow": "^2.4.0",
    "mailparser": "^3.9.38",
    "markdown-it": "^15.0.2",
    "nodemailer": "^10.1.0",
    "onnxruntime-node": "1.30.0",
    "parse5": "8.0.1",
    "parse5-htmlparser2-tree-adapter": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "postal-mime": "4.0.5",
    "punycode.js": "2.3.1",
    "semver": "^7.8.5",
    "sqlite-vec": "0.1.9",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@types/css-tree": "^3.2.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/punycode.js": "npm:@types/punycode@2.1.4",
    "@types/semver": "^7.8.0",
    "fast-check": "^4.10.2",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
