  {
    "description": "Search the local copy with words and Gmail-style operators. Use it to find specific mail; set server to also ask the provider. Returns up to 200 results; page with next_cursor.",
    "idempotent": true,
    "input": {
      "additionalProperties": true,
      "properties": {
        "account_id": {
          "description": "An id from list_accounts.",
