          "type": "integer",
        },
        "query": {
          "description": "Words and operators: from:, to:, subject:, after:, before:, is:unread, has:attachment, label:, in:attachment.",
          "maxLength": 4096,
          "minLength": 1,
          "type": "string",
        },
        "server": {
          "description": "Also fetch the provider's hits into the local copy. Unsupported operators are listed under ignored, failed accounts under errors.",
          "type": "boolean",
        },
        "token_budget": {
