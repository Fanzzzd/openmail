  {
    "description": "Report which accounts this client can read, how many are hidden and why, and whether it can propose changes. Call it first, and again when a result is unexpectedly empty. Relay next_steps to the person.",
    "idempotent": true,
    "input": {
      "additionalProperties": false,
      "type": "object",
    },
    "name": "access_status",
    "openWorld": false,
    "output": {
      "definitions": {},
