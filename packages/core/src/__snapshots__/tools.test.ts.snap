        "token_budget": {
          "description": "Maximum JSON UTF-8 bytes, a conservative token bound. Default 12000; 2000 to 24000.",
          "maximum": 24000,
          "minimum": 2000,
          "type": "integer",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
