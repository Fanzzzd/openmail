                    },
                    "cc": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "date": {
                      "type": "string",
                    },
                    "flags": {
                      "items": {
                        "enum": [
                          "hidden-text-removed",
                          "plain-differs",
