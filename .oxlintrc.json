{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "unicorn/prefer-set-has": "error",
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/media-has-caption": "off",
    "eslint/no-else-return": "error",
    "eslint/no-lonely-if": "error",
    "eslint/no-warning-comments": [
      "error",
      {
        "terms": ["fixme", "xxx", "hack", "todo:"],
        "location": "anywhere"
      }
    ],
    "eslint/default-case-last": "error",
    "eslint/no-empty": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/prefer-template": "error",
    "eslint/no-console": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-empty-function": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-undefined": [
      "error",
      {
        "checkArguments": false
      }
    ],
    "unicorn/prefer-ternary": "error",
    "import/no-self-import": "error",
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    "import/no-duplicates": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-type-assertion": "warn",
    "eslint/prefer-object-spread": "error",
    "typescript/prefer-optional-chain": "error",
    "unicorn/no-array-for-each": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "eslint/no-shadow": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["scripts/**", "apps/mobile/scripts/**"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["apps/desktop/src/main/**"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["apps/mobile/**"],
      "rules": {
        "unicorn/no-array-sort": "off",
        "react/style-prop-object": [
          "error",
          {
            "allow": ["StatusBar"]
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "@effect/platform-node",
                  "@effect/platform-node/*",
                  "@effect/platform-node-shared",
                  "@effect/platform-node-shared/*",
                  "@effect/sql-sqlite-node",
                  "@effect/sql-sqlite-node/*",
                  "@napi-rs/keyring",
                  "@napi-rs/keyring/*",
                  "sqlite-vec",
                  "sqlite-vec/*",
                  "onnxruntime-node",
                  "onnxruntime-node/*",
                  "imapflow",
                  "imapflow/*",
                  "nodemailer",
                  "nodemailer/*",
                  "mailparser",
                  "mailparser/*",
                  "pdfjs-dist",
                  "pdfjs-dist/*",
                  "@huggingface/transformers",
                  "@huggingface/transformers/*",
                  "better-sqlite3",
                  "better-sqlite3/*"
                ],
                "message": "Keep native imports in packages/core/src/platform/node; portable core uses Effect platform services."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/platform/node/**", "packages/core/src/**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/ui/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/routes/**", "**/app/**", "**/features/**", "**/state/**"],
                "message": "ui/ holds primitives: pass data in as props instead of importing app, features or state."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/lib/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/routes/**", "**/app/**", "**/features/**", "**/state/**", "**/ui/**"],
                "message": "lib/ holds pure helpers: it must not import app, features, state or ui."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/state/**", "apps/desktop/src/renderer/src/i18n/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/routes/**", "**/app/**", "**/features/**"],
                "message": "state/ and i18n/ sit below features: move the shared code down instead of importing app or features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/features/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/routes/**", "**/app/**"],
                "message": "features/ must not import routes/ or app/: move the shared code into the feature, state, ui or lib."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/app/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/routes/**"],
                "message": "routes/ sits above app/: read the location from state/location instead of importing the router."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "apps/mobile/.expo/**",
    "apps/mobile/android/**",
    "apps/mobile/ios/**",
    "apps/web/public/vendor/**",
    "apps/web/public/widget.js",
    "apps/web/scripts/_tmp-vendor/**",
    "packages/drawnix/src/**",
    "packages/drawnix-react-board/src/**",
    "packages/drawnix-react-text/src/**",
    "apps/docs/.next/**",
    "apps/docs/out/**",
    "apps/docs/next-env.d.ts"
  ],
  "options": {
    "typeAware": true
  }
}
