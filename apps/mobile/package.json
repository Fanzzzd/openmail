{
  "name": "@openmail/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "pnpm i18n:compile && pnpm check-types",
    "check-types": "tsc --noEmit",
    "test": "vitest run && lingui check sync --clean --workers 1 && lingui check missing --mode catalog --workers 1",
    "start": "expo start --dev-client",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript --strict && oxfmt src/locales/*/messages.ts"
  },
  "dependencies": {
    "@lingui/core": "^6.9.1",
    "@lingui/react": "^6.9.1",
    "@noble/hashes": "^2.4.0",
    "@op-engineering/op-sqlite": "18.2.5",
    "@openmail/core": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "effect": "4.0.3",
    "expo": "57.0.28",
    "expo-auth-session": "~57.0.15",
    "expo-background-task": "~57.0.21",
    "expo-battery": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "punycode": "2.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tcp-socket": "6.4.3",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@lingui/cli": "^6.9.1",
    "@lingui/format-po": "^6.9.1",
    "@react-native/metro-config": "0.86.3",
    "@types/node": "^24.19.2",
    "@types/punycode": "2.1.4",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "babel-preset-expo": "~57.0.15",
    "jsdom": "30.1.2",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  },
  "op-sqlite": {
    "fts5": true,
    "iosSqlite": false
  }
}
