{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "react"],
    "noEmit": true
  },
  "include": [
    "app",
    "src",
    "app.config.ts",
    "lingui.config.ts",
    "vitest.config.ts",
    "../../packages/core/src/css-tree-browser-api.d.ts"
  ]
}
