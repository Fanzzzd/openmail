{
  "name": "@openmail/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "openmail desktop app",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node build/build-vision.mjs && electron-vite dev",
    "build": "node build/build-vision.mjs && electron-vite build",
    "check-types": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "pnpm dist",
    "test": "vitest run && vitest run --config vitest.e2e.config.ts && lingui check sync --clean --workers 1 && lingui check missing --mode catalog --workers 1 && node scripts/i18n-missing.mjs",
    "i18n:extract": "lingui extract --clean",
    "dist": "pnpm --filter @openmail/core build && pnpm build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:signed": "OPENMAIL_SIGNED_BUILD=1 pnpm dist",
    "i18n:missing": "node scripts/i18n-missing.mjs"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.118",
    "@lingui/core": "^6.8.0",
    "@lingui/react": "^6.8.0",
    "@openmail/core": "workspace:*",
    "effect": "4.0.0-rc.118",
    "electron-updater": "^6.8.9",
    "react-resizable-panels": "^4.14.1",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron/fuses": "2.1.3",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/selfhst": "^1.2.21",
    "@iconify-json/thesvg-color": "^1.2.13",
    "@lingui/babel-plugin-lingui-macro": "^6.8.0",
    "@lingui/cli": "^6.8.0",
    "@lingui/format-po": "^6.8.0",
    "@lingui/vite-plugin": "^6.8.0",
    "@messageformat/parser": "5.1.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "colorjs.io": "0.7.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "30.1.1",
    "linkedom": "0.18.13",
    "lucide-react": "^1.48.0",
    "node-api-headers": "^1.9.0",
    "postcss": "8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "unplugin-icons": "^24.0.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "productName": "OpenMail"
}
